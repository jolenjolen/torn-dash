# Copy to .env and fill in. Never commit .env.

# ---------- server ----------
# The server's own Torn key (Limited Access). Used only to collect the shared market
# history. If empty, the owner's key (first player to sign in) is used instead.
TORN_KEY=

# Encrypts stored API keys and signs sessions. Leave empty to auto-generate one in
# data/secret.key. If you set it, keep it secret and never change it (stored keys
# become unreadable and players have to sign in again).
SECRET_KEY=

# Who can sign in
ALLOW_SIGNUPS=true
# Comma-separated Torn player ids that may always sign in (useful with ALLOW_SIGNUPS=false)
ALLOWED_PLAYERS=
MAX_USERS=0
SESSION_DAYS=30
# auto = secure cookies when the request came in over HTTPS
COOKIE_SECURE=auto

# ---------- advisor ----------
# Players add their own Gemini key in Settings. These are only for the owner,
# plus any player ids listed in SHARE_GEMINI_WITH.
GEMINI_API_KEY=
SHARE_GEMINI_WITH=
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_LIMIT=20
# Optional: Vertex AI for the owner instead of an API key
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=

# ---------- planner & notifications ----------
# How often (seconds) each player's timers (rent, missions, refills, OC…) refresh
TIMERS_EVERY=300
# With notifications on, refresh a player's data in the background at most this often
NOTIFY_REFRESH=600
# Contact for push services (mailto: or https:)
VAPID_SUBJECT=mailto:admin@example.com

# ---------- request budget ----------
TORN_RPM=50
USER_RPM=30

# ---------- shared market logging ----------
PRICES_EVERY=3600
MARKET_SWEEP_RPM=4
SWEEP_MIN_VALUE=1000
PRUNE_AFTER_DAYS=90
# Start from someone's exported history (scripts/export_market.py)
# SEED_DB=seed/market.db

# ---------- trade ----------
WALLET_WARN=5000
WATCH_TOP_CANDIDATES=10
MIN_CANDIDATE_VALUE=10000
